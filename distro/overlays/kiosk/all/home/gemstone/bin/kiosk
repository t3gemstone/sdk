#!/usr/bin/env python3
"""Gemstone Example Control Station.

Qt Quick rather than QtWidgets. The scene graph draws through OpenGL, so this
runs on the GPU under the eglfs kiosk backend. QtWidgets paints into a raster
backingstore that Qt then uploads as a texture, and that upload produces nothing
on the PowerVR driver -- see /etc/gemstone/kiosk.conf.

The UI lives in kiosk.qml next to this file. Everything here is the data source:
replace Telemetry._tick() with real values and the display follows.
"""

import math
import sys
from pathlib import Path

from PyQt5.QtCore import QObject, QTimer, QUrl, pyqtProperty, pyqtSignal
from PyQt5.QtGui import QGuiApplication
from PyQt5.QtQml import QQmlApplicationEngine


class Telemetry(QObject):
    """Simulated UAV telemetry, refreshed every 100 ms."""

    updated = pyqtSignal()

    def __init__(self, parent=None):
        super().__init__(parent)

        self._time = 0.0
        self._altitude = 0.0
        self._speed = 0.0
        self._battery = 0.0

        self._timer = QTimer(self)
        self._timer.timeout.connect(self._tick)
        self._timer.start(100)

    def _tick(self):
        self._time += 0.1
        self._altitude = 500 + 500 * math.sin(self._time)
        self._speed = 50 + 50 * math.sin(self._time * 0.5)
        self._battery = 50 + 50 * math.sin(self._time * 0.2)
        self.updated.emit()

    @pyqtProperty(float, notify=updated)
    def altitude(self):
        return self._altitude

    @pyqtProperty(float, notify=updated)
    def speed(self):
        return self._speed

    @pyqtProperty(float, notify=updated)
    def battery(self):
        return self._battery


def main():
    app = QGuiApplication(sys.argv)
    app.setApplicationName("Gemstone Example Control Station")

    telemetry = Telemetry()

    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("telemetry", telemetry)
    engine.load(QUrl.fromLocalFile(str(Path(__file__).resolve().parent / "kiosk.qml")))

    if not engine.rootObjects():
        return 1

    return app.exec_()


if __name__ == "__main__":
    sys.exit(main())
